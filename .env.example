# =====================================================================
# Configuration for Context-Aware Multi-Turn LLM Chatbot
# =====================================================================

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Settings (Get your key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Settings (Get your key at: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Context Window Management Strategy
# Options: "truncation" (sliding window of last N messages) or "summarization" (running summary + recent messages)
CONTEXT_STRATEGY=truncation

# Truncation Window Size (number of recent messages sent to the LLM)
MAX_HISTORY_MESSAGES=6

# Summarization Trigger Threshold (summarizes when message count exceeds this)
SUMMARY_TRIGGER_THRESHOLD=6

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Bot Persona Settings
BOT_NAME=Atlas
BOT_ROLE=Senior Software Architect & Technical Career Mentor
